From: 梦龙 <chen.menglong@outlook.com>
Subject: [PATCH] qca-nss-ecm: use sockaddr_unsized for proto_ops bind

Linux 6.18.57 changed proto_ops::bind to take struct sockaddr_unsized.
ECM passes a struct sockaddr_nl, so keep the same address and cast it to
the callback's declared pointer type.

---
# Not from the pinned fork. Delete this patch once ECM uses the 6.18
# proto_ops::bind type directly.

--- a/ecm_interface.c
+++ b/ecm_interface.c
@@ -9044,7 +9044,7 @@
 	saddr.nl_family = AF_NETLINK;
 	saddr.nl_pid    = current->pid;
 
-	err = __ewn.sock->ops->bind(__ewn.sock, (struct sockaddr *)&saddr, sizeof(struct sockaddr));
+	err = __ewn.sock->ops->bind(__ewn.sock, (struct sockaddr_unsized *)&saddr, sizeof(struct sockaddr));
 	if (err < 0) {
 		DEBUG_ERROR("failed to bind sock err %d\n", err);
 		goto exit2;
@@ -9274,7 +9274,7 @@
 	saddr.nl_groups = RTNLGRP_LINK;
 	saddr.nl_pid    = current->pid;
 
-	err = __ewn.sock->ops->bind(__ewn.sock, (struct sockaddr *)&saddr, sizeof(struct sockaddr));
+	err = __ewn.sock->ops->bind(__ewn.sock, (struct sockaddr_unsized *)&saddr, sizeof(struct sockaddr));
 	if (err < 0) {
 		DEBUG_ERROR("failed to bind sock\n");
 		goto exit2;
