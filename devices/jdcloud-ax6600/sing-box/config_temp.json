{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "dns-direct",
        "type": "local"
      }
    ],
    "final": "dns-direct"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "sing-box0",
      "address": [
        "172.19.0.1/30",
        "fd00::1/126"
      ],
      "mtu": 9000,
      "auto_route": true,
      "auto_redirect": true,
      "strict_route": false
    },
    {
      "type": "socks",
      "tag": "socks-proxy-in",
      "listen": "::",
      "listen_port": 1080
    },
    {
      "type": "socks",
      "tag": "socks-direct-in",
      "listen": "::",
      "listen_port": 1081
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "socks",
      "tag": "proxy",
      "server": "127.0.0.1",
      "server_port": 7890
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "rules": [
      {
        "inbound": [
          "socks-proxy-in"
        ],
        "action": "route",
        "outbound": "proxy"
      },
      {
        "inbound": [
          "socks-direct-in"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "inbound": [
          "tun-in"
        ],
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": "bypass",
        "action": "route",
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": "proxy",
        "action": "route",
        "outbound": "proxy"
      }
    ],
    "rule_set": [
      {
        "tag": "bypass",
        "type": "local",
        "format": "source",
        "path": "/var/lib/liminix/sing-box/bypass.json"
      },
      {
        "tag": "proxy",
        "type": "local",
        "format": "source",
        "path": "/var/lib/liminix/sing-box/proxy.json"
      }
    ],
    "final": "direct",
    "default_domain_resolver": "dns-direct"
  }
}
